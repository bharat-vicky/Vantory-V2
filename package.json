{
  "name": "vantory",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "predev": "prisma generate",
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "security:check": "node scripts/check-repo-secrets.mjs",
    "security:history": "node scripts/check-repo-secrets.mjs --history",
    "auth:check": "node scripts/check-auth-connectivity.mjs",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:generate": "prisma generate",
    "test": "node --import tsx --import ./tests/isolated-env.mjs --test tests/applicant-tools.test.ts tests/candidate-upgrades.test.ts tests/career-workflows.test.ts tests/feedback-inbox.test.ts tests/ai.test.ts tests/ats.test.ts tests/auth-multi-role.test.ts tests/auth-ui.test.ts tests/auth.test.ts tests/company-jobs.test.ts tests/company.test.ts tests/foundation.test.ts tests/google-auth.test.ts tests/institute-api.test.ts tests/institute-service.test.ts tests/student-csv.test.ts tests/interview.test.ts tests/isolation.test.ts tests/jobs.test.ts tests/pdf-engine.test.ts tests/preparation.test.ts tests/resume.test.ts tests/support.test.ts",
    "typecheck": "tsc --noEmit --incremental false"
  },
  "dependencies": {
    "@prisma/client": "^6.4.1",
    "bcryptjs": "^3.0.2",
    "clsx": "^2.1.1",
    "framer-motion": "^12.4.7",
    "html2pdf.js": "^0.14.0",
    "jose": "^6.0.8",
    "lenis": "^1.3.26",
    "lucide-react": "^0.475.0",
    "mammoth": "^1.13.0",
    "next": "^15.5.27",
    "nodemailer": "^10.0.14",
    "pdfjs-dist": "^4.10.38",
    "pdfkit": "^0.19.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.13.4",
    "@types/nodemailer": "^8.0.1",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.20.1",
    "eslint-config-next": "^15.5.27",
    "postcss": "^8.5.28",
    "prisma": "^6.4.1",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.12",
    "typescript": "^5.7.3"
  },
  "overrides": {
    "postcss": "$postcss",
    "deepmerge-ts": "^8.0.2"
  }
