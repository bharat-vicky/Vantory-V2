# Copy to .env for local use. Set deployment values in Vercel; never commit them.
# NEXT_PUBLIC_* values are visible in the browser. Never put secrets in them.
# Database Configuration
MONGODB_URI="mongodb+srv://<username>:<password>@<cluster-host>/vantory?retryWrites=true&w=majority"

# Authentication & Security
# Generate a unique secret with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
JWT_SECRET="replace-with-a-random-secret-of-at-least-32-characters"
GOOGLE_CLIENT_ID="your-google-oauth-client-id"
GOOGLE_CLIENT_SECRET="your-google-oauth-client-secret"
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"

# Application URLs
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# AI Service Credentials
GEMINI_API_KEY="your-gemini-api-key-here"

# Real-Time Support Email Dispatch (Nodemailer)
SUPPORT_RECIPIENT_EMAIL="support@yourdomain.com"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-16-character-app-password-here"
SMTP_FROM=""

# Public Contact Information (Optional)
NEXT_PUBLIC_SUPPORT_PHONE=""
NEXT_PUBLIC_SUPPORT_EMAIL="support@yourdomain.com"

# Assessment models (explicitly choose and review before deployment)
GEMINI_MODEL="gemini-2.5-flash"
INTERVIEW_MODEL="gemini-2.5-flash"

# Dedicated, patched Judge0 service. Never point this at the Vantory app host.
# Keep the token server-side and disable network on the runner itself.
JUDGE0_URL=""
JUDGE0_TOKEN=""
JUDGE0_PYTHON_LANGUAGE_ID=71
JUDGE0_SQL_LANGUAGE_ID=82

# External scheduler: POST /api/internal/support-dispatch with Authorization: Bearer <secret>
# Use a separate random secret of at least 32 characters if scheduling delivery retries.
CRON_SECRET=""
ALLOW_DEMO_SEED=false
